rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email == "sarbanunesa66@gmail.com" &&
        request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // USERS
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isOwner(userId) &&
        incoming().uid == userId &&
        incoming().keys().hasAll(['uid', 'name', 'email', 'createdAt', 'accountStatus', 'currentLevel']) &&
        (incoming().isAdmin == false || isAdmin());
      allow update: if (isOwner(userId) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        (incoming().isAdmin == existing().isAdmin || isAdmin())) || isAdmin();
      allow delete: if isAdmin();
    }

    // QUIZ CATEGORIES
    match /quiz_categories/{categoryId} {
      allow get, list: if isSignedIn();
      allow write: if isAdmin();
    }

    // QUESTIONS
    match /questions/{questionId} {
      allow get, list: if isSignedIn();
      allow write: if isAdmin();
    }

    // LEVELS
    match /levels/{levelId} {
      allow get, list: if isSignedIn();
      allow write: if isAdmin();
    }

    // EXAMS
    match /exams/{examId} {
      allow get, list: if isSignedIn();
      allow write: if isAdmin();
    }

    // WALLETS
    match /wallets/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) &&
        incoming().uid == userId &&
        incoming().keys().hasAll(['uid', 'availablePoints', 'reservedPoints', 'lifetimeEarnedPoints']);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // TRANSACTIONS
    match /transactions/{transactionId} {
      allow get: if isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // WITHDRAWALS
    match /withdrawals/{withdrawalId} {
      allow get: if isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        incoming().uid == request.auth.uid &&
        incoming().status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // DAILY REWARDS
    match /daily_rewards/{rewardId} {
      allow get: if isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // AD SETTINGS
    match /ad_settings/{providerId} {
      allow get, list: if isSignedIn();
      allow write: if isAdmin();
    }

    // APP SETTINGS
    match /app_settings/{settingsId} {
      allow get, list: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
